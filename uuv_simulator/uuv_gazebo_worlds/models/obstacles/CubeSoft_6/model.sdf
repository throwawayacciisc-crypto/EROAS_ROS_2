<?xml version='1.0' ?>
<sdf version="1.11">
    <model name="CubeSoft">
        <static>true</static>
        <link name="link">
            <pose>0 0 0 1.57 3.14159 0</pose>
            <collision name="collision">
                <!-- Original EROAS mesh collision (the port had replaced it with the
                     bounding box, which filled the non-convex notches with invisible
                     solid volume the sonar cannot see). Convex decomposition lets
                     bullet-featherstone collide with the true non-convex shape. -->
                <geometry>
                    <mesh optimization="convex_decomposition">
                        <convex_decomposition><max_convex_hulls>16</max_convex_hulls></convex_decomposition>
                        <uri>meshes/6.stl</uri>
                        <scale>0.001 0.001 0.001</scale>
                    </mesh>
                </geometry>
            </collision>
            <visual name="visual">
                <geometry>
                    <mesh>
                        <uri>meshes/6.stl</uri>
                        <scale>0.001 0.001 0.001</scale>
                    </mesh>
                </geometry>
                <material>
                    <ambient>0.0 0.22 0.95 1</ambient>
                    <diffuse>0.0 0.35 1.0 1</diffuse>
                    <specular>0.08 0.12 0.20 1</specular>
                </material>
            </visual>
        </link>
    </model>
</sdf>
