<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dave_multibeam_sonar</name>
  <version>0.0.1</version>
  <description>
    DAVE multibeam sonar sensor and system (IOES-Lab/dave, gazebo/dave_gz_multibeam_sonar)
    built for ROS 2 Jazzy / Gazebo Harmonic. Requires an NVIDIA GPU and the CUDA toolkit.
  </description>
  <maintainer email="wschoi@kmou.ac.kr">Woen-Sug Choi</maintainer>
  <maintainer email="helenamoyen@gmail.com">Helena Moyen</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>marine_acoustic_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>eigen</depend>
  <depend>gz_sim_vendor</depend>
  <depend>gz_sensors_vendor</depend>
  <depend>gz_rendering_vendor</depend>
  <depend>gz_transport_vendor</depend>
  <depend>gz_msgs_vendor</depend>
  <depend>gz_math_vendor</depend>
  <depend>gz_common_vendor</depend>
  <depend>gz_plugin_vendor</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
